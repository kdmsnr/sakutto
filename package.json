{
  "name": "lmsakutto",
  "version": "1.1.0",
  "private": true,
  "description": "Local web page translation with PLaMo 3 Translate.",
  "license": "MIT",
  "author": "jammaru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jammaru/sakutto.git"
  },
  "homepage": "https://github.com/jammaru/sakutto",
  "bugs": {
    "url": "https://github.com/jammaru/sakutto/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node scripts/sync-licenses.mjs && wxt",
    "build": "node scripts/sync-licenses.mjs && wxt build && node scripts/copy-extension.mjs",
    "zip": "node scripts/sync-licenses.mjs && wxt zip && node scripts/verify-package.ts",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/sync-licenses.mjs && wxt prepare && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --configLoader runner",
    "test:e2e": "node scripts/run-e2e.mjs",
    "bench": "node scripts/bench/run.ts",
    "bench:mock": "node scripts/bench/pages-run.ts --mode mock",
    "bench:live": "node scripts/bench/pages-run.ts --mode live",
    "bench:build:mock": "node scripts/sync-licenses.mjs && SAKUTTO_FAKE_ENGINE=1 wxt build",
    "bench:build:live": "node scripts/sync-licenses.mjs && SAKUTTO_E2E_REAL=1 wxt build",
    "bench:serve": "node scripts/bench/static.ts",
    "bench:history": "node scripts/bench/report.ts",
    "i18n:check": "node scripts/i18n/check-locales.mjs",
    "i18n:draft": "node scripts/i18n/generate-locale.mjs",
    "release": "node scripts/release/cli.ts",
    "test:e2e:api": "SAKUTTO_E2E_MOCK_API=1 node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
